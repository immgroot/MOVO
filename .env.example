# Optional. Set the real trusted web origin when hosting later.
# MOVO_ORIGIN=https://your-domain.example
# MOVO_PUBLIC_ORIGIN=https://your-domain.example
# MOVO_DB=.data/movo.sqlite
# PORT=3000

# Accounts use Better Auth with a separate SQLite database.
# For LAN use, set this to the exact address opened by players.
# BETTER_AUTH_URL=http://localhost:3000
# MOVO_AUTH_DB=.data/accounts.sqlite
# Set a high-entropy 32+ character secret for a future hosted environment.
# Local development creates and retains .data/auth-secret automatically.
# BETTER_AUTH_SECRET=
# Google/Discord OAuth and email delivery are not configured.
